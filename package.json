{
  "name": "pheonix",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "build:android": "eas build --platform android --profile production --non-interactive",
    "submit:android": "eas submit --platform android --profile production --latest --non-interactive",
    "build:web": "expo build:web --no-interactive",
    "tauri:dev": "cd src-tauri && cargo run",
    "tauri:build": "npm run build:web && rm -rf src-tauri/dist && cp -R web-build src-tauri/dist && cd src-tauri && cargo build --release",
    "cap:sync": "npx cap sync android",
    "cap:open": "npx cap open android",
    "android:bundle": "cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "expo": "~51.0.28",
    "expo-asset": "~10.0.10",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-webview": "13.8.6"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@tauri-apps/cli": "^1.4.0"
  }
}
