<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. Cleartext (HTTP) is disabled for Play-ready hardening. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
